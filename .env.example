# Forja HUB — copie pra .env.local

# ── BANCO (Supabase) ──────────────────────────────────────────────
# 1) Crie um projeto em https://supabase.com
# 2) Em "Connect" pegue:
#    - URI (transaction pooler, porta 6543)  →  DATABASE_URL
#    - URI (session pooler, porta 5432)      →  DIRECT_URL  (usado pelas migrations)
# pgvector já vem habilitado por padrão no Supabase.
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ── LLM (Anthropic) ───────────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."
# opcional — override do default (claude-sonnet-4-6)
# ANTHROPIC_MODEL="claude-opus-4-7"

# ── EMBEDDINGS (Voyage AI) ────────────────────────────────────────
# https://dash.voyageai.com/api-keys  (Voyage é parceira oficial Anthropic)
# voyage-3-large devolve 1024 dims — combina com o schema atual.
VOYAGE_API_KEY="pa-..."
# opcional — override do default (voyage-3-large)
# VOYAGE_MODEL="voyage-3"
